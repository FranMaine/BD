<%- include('partials/header') %>

<p class="eyebrow">Palabra clave</p>
<h1 class="hero-title">"<%= kw %>"</h1>

<% if (movies.length) { %>
    <div class="grid">
        <% movies.forEach(function(m, i) { %>
            <%- include('partials/movie-tile', { m: m, i: i }) %>
        <% }); %>
    </div>
<% } else { %>
    <p class="empty-state">No se encontraron peliculas con esa palabra clave.</p>
<% } %>

<p><a href="/keyword">← Nueva busqueda por palabra clave</a></p>

<%- include('partials/footer') %>
