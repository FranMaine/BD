<%- include('partials/header') %>

<div class="detail-hero">
    <% if (tmdbData && tmdbData.profileUrl) { %>
        <img src="<%= tmdbData.profileUrl %>" alt="Foto de <%= person.name %>">
    <% } else { %>
        <div class="poster-placeholder detail-hero-placeholder"><span><%= person.name.charAt(0) %></span></div>
    <% } %>
    <div class="info">
        <p class="eyebrow">Director</p>
        <h1 class="hero-title"><%= person.name %></h1>
        <p>
            <% if (tmdbData && tmdbData.birthday) { %><span class="badge">Nacimiento: <%= tmdbData.birthday %></span><% } %>
            <% if (person.country) { %><span class="badge"><%= person.country %></span><% } %>
        </p>
        <p><%= (tmdbData && tmdbData.biography) || person.biography || 'Sin biografia disponible.' %></p>
    </div>
</div>

<h2 class="section-title">Peliculas dirigidas</h2>
<% if (movies.length) { %>
    <div class="grid">
        <% movies.forEach(function(m, i) { %>
            <%- include('partials/movie-tile', { m: m, i: i }) %>
        <% }); %>
    </div>
<% } else { %>
    <p class="empty-state">Sin peliculas registradas.</p>
<% } %>

<%- include('partials/footer') %>
